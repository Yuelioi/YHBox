{
  "name": "frontend",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:dev": "vite build --minify false --mode development",
    "build": "run-s build:app bundle:check",
    "build:app": "vite build --mode production",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "type-check": "vue-tsc --noEmit",
    "i18n:check": "node src/i18n/check.cjs",
    "check": "run-s format:check lint typecheck i18n:check bindings:check test build",
    "check:quick": "run-s format:check lint typecheck i18n:check test",
    "lint": "run-s lint:oxlint lint:eslint",
    "lint:oxlint": "oxlint . --deny-warnings",
    "lint:eslint": "node scripts/check-eslint.mjs",
    "lint:fix": "run-s lint:fix:oxlint lint:fix:eslint",
    "lint:fix:oxlint": "oxlint . --fix",
    "lint:fix:eslint": "eslint . --fix --cache",
    "lint:baseline:update": "node scripts/check-eslint.mjs --write",
    "format": "oxfmt src/ scripts/ eslint.config.ts vite.config.ts package.json bundle-budgets.json lint-baseline.json",
    "format:check": "oxfmt src/ scripts/ eslint.config.ts vite.config.ts package.json bundle-budgets.json lint-baseline.json --check",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "bindings:check": "node scripts/check-bindings-contract.mjs",
    "bindings:update": "node scripts/check-bindings-contract.mjs --write"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@iconify-json/tabler": "^1.2.35",
    "@intlify/unplugin-vue-i18n": "^11.2.0",
    "@lezer/highlight": "^1.2.3",
    "@nuxt/ui": "^4.7.1",
    "@replit/codemirror-indentation-markers": "^6.5.3",
    "@tailwindcss/vite": "^4.3.0",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@vueuse/core": "^14.3.0",
    "@wailsio/runtime": "3.0.0-alpha.97",
    "elkjs": "0.11.1",
    "markdown-it": "^14.2.0",
    "pinia": "^3.0.4",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.0",
    "vue": "^3.5.34",
    "vue-draggable-plus": "^0.6.1",
    "vue-i18n": "^9.14.5",
    "vue-router": "^5.0.7"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/eslint-config-typescript": "^14.7.0",
    "esbuild": "^0.27.7",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.64.0",
    "eslint-plugin-vue": "^10.9.1",
    "happy-dom": "^20.9.0",
    "jiti": "^2.7.0",
    "json-schema-to-typescript": "15.0.4",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.50.0",
    "oxlint": "^1.64.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6",
    "vue-tsc": "^3.2.9"
  },
  "engines": {
    "node": "24.18.0"
  },
  "packageManager": "pnpm@11.1.2"
}
