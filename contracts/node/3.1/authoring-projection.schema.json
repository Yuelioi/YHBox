            "$ref": "#/$defs/PortProjection"
          },
          "type": "array"
        },
        "dataOutputs": {
          "items": {
            "$ref": "#/$defs/PortProjection"
          },
          "type": "array"
        },
        "descriptionKey": {
          "type": "string"
        },
        "editorAdapter": {
          "type": "string"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/ErrorSpec"
