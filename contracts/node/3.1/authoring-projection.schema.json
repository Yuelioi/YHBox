          "$ref": "#/$defs/TypeExpression"
        },
        "label": {
          "type": "string"
        },
        "lifecycle": {
          "enum": [
            "durable",
            "runtime-only",
            "durable-or-runtime",
            "resolved-at-compile"
          ],
          "type": "string"
        },
        "representations": {
          "items": {
            "$ref": "#/$defs/RepresentationSpec"
          },
          "type": "array"
        },
        "titleKey": {
          "type": "string"
        },
        "typeIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "expression",
        "label",
        "typeIds",
        "representations",
        "lifecycle"
