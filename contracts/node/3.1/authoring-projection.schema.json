        "signals": {
          "items": {
            "$ref": "#/$defs/SignalProjection"
          },
          "type": "array"
        },
        "statusEvents": {
          "items": {
            "$ref": "#/$defs/StatusEventSpec"
          },
          "type": "array"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "titleKey": {
          "type": "string"
        }
