          "type": "string"
        },
        "default": true,
        "deprecated": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "descriptionKey": {
          "type": "string"
        },
        "examples": {
          "items": true,
          "type": "array"
        },
        "hasDefault": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "items": {
          "$ref": "#/$defs/FieldProjection"
        },
        "properties": {
          "items": {
            "$ref": "#/$defs/FieldProjection"
          },
          "type": "array"
        },
        "readOnly": {
          "type": "boolean"
        },
        "required": {
          "type": "boolean"
        },
        "title": {
          "type": "string"
        },
        "titleKey": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "control",
        "required",
        "hasDefault",
        "examples",
        "deprecated",
        "readOnly",
        "constraints",
        "properties"
      ],
      "type": "object"
