{
  "$defs": {
    "CapabilityProjection": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "$ref": "#/$defs/Ref"
        },
        "consent": {
          "enum": [
            "none",
            "once",
            "every-run"
          ],
          "type": "string"
        },
        "credential": {
          "enum": [
            "none",
            "required"
          ],
          "type": "string"
        },
        "credentialSlot": {
          "type": "string"
        },
        "operations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "requirementId": {
          "type": "string"
        },
        "risk": {
          "enum": [
            "low",
            "sensitive",
            "dangerous"
          ],
          "type": "string"
        },
        "scope": true,
        "targetKinds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "targetSlot": {
          "type": "string"
        }
      },
      "required": [
        "requirementId",
        "capability",
        "operations",
        "scope",
        "targetSlot",
        "targetKinds",
        "credential",
        "risk",
        "consent"
      ],
      "type": "object"
    },
    "ErrorSpec": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "code": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "retryHint": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "category",
        "retryHint"
      ],
      "type": "object"
    },
    "ExecutionSpec": {
      "additionalProperties": false,
      "properties": {
        "cache": {
          "enum": [
            "none",
            "per-run"
          ],
          "type": "string"
        },
        "cancellation": {
          "enum": [
            "cooperative",
            "immediate",
            "unsupported"
          ],
          "type": "string"
        },
        "class": {
          "enum": [
            "pure-data",
            "effect",
            "control",
            "event",
            "region",
            "marker",
            "visual"
          ],
          "type": "string"
        },
        "determinism": {
          "enum": [
            "deterministic",
            "recorded",
            "nondeterministic"
          ],
          "type": "string"
        },
        "effects": {
          "items": {
            "type": "string"
          },
          "maxItems": 4096,
          "type": "array"
        },
        "evaluation": {
          "enum": [
            "pull",
            "push"
          ],
          "type": "string"
        },
        "retry": {
          "enum": [
            "never",
            "idempotent",
            "operation-id"
          ],
          "type": "string"
        },
        "timeout": {
          "enum": [
            "none",
            "required",
            "optional"
          ],
          "type": "string"
        }
      },
      "required": [
        "class",
        "effects",
        "determinism",
        "evaluation",
        "cache",
        "retry",
        "cancellation",
        "timeout"
      ],
      "type": "object"
    },
    "FieldConstraints": {
      "additionalProperties": false,
      "properties": {
        "enum": {
          "items": true,
          "type": "array"
        },
        "maxItems": {
          "type": "integer"
        },
        "maxLength": {
          "type": "integer"
        },
        "maximum": true,
        "minItems": {
          "type": "integer"
        },
        "minLength": {
          "type": "integer"
        },
        "minimum": true,
        "pattern": {
          "type": "string"
        }
      },
      "required": [
        "enum"
      ],
      "type": "object"
    },
    "FieldProjection": {
      "additionalProperties": false,
      "properties": {
