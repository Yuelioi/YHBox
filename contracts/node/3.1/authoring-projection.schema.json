            "kind": {
              "const": "variable",
              "type": "string"
            },
            "variable": {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "kind",
            "variable"
          ],
          "type": "object"
        }
