{
  "$defs": {
    "Annotation": {
      "additionalProperties": false,
      "properties": {
        "color": {
          "maxLength": 32,
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*$",
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/Position"
        },
        "size": {
          "$ref": "#/$defs/Size"
        },
        "text": {
          "maxLength": 16384,
          "type": "string"
        }
      },
      "required": [
        "id",
        "text",
        "position",
        "size"
      ],
      "type": "object"
    },
    "BlobRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "mediaType": {
          "maxLength": 255,
          "minLength": 3,
          "pattern": "^[a-z0-9][a-z0-9!#$\u0026^_.+-]+/[a-z0-9][a-z0-9!#$\u0026^_.+-]+$",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "mediaType",
        "digest",
        "size"
      ],
      "type": "object"
    },
    "Edge": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "enum": [
            "data",
            "exec",
            "error"
          ],
          "type": "string"
        },
        "from": {
          "$ref": "#/$defs/Endpoint"
        },
        "presentation": {
          "$ref": "#/$defs/EdgePresentation"
        },
        "to": {
          "$ref": "#/$defs/Endpoint"
        }
      },
      "required": [
        "channel",
        "from",
        "to"
      ],
      "type": "object"
    },
    "EdgePresentation": {
      "additionalProperties": false,
      "properties": {
        "reroutes": {
          "items": {
            "$ref": "#/$defs/Position"
          },
          "maxItems": 64,
          "type": "array"
        }
      },
      "type": "object"
    },
    "Endpoint": {
      "additionalProperties": false,
      "properties": {
        "nodeId": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*$",
          "type": "string"
        },
        "portId": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*$",
          "type": "string"
        }
      },
      "required": [
        "nodeId",
        "portId"
      ],
      "type": "object"
    },
    "Graph": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "items": {
            "$ref": "#/$defs/Annotation"
          },
          "maxItems": 4096,
          "type": "array"
        },
        "calls": {
          "items": {
            "$ref": "#/$defs/GraphCall"
          },
          "maxItems": 4096,
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/Edge"
          },
          "maxItems": 16384,
          "type": "array"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/Endpoint"
          },
          "maxItems": 64,
          "type": "array"
        },
        "exits": {
          "items": {
            "$ref": "#/$defs/GraphExit"
          },
          "maxItems": 64,
          "type": "array"
        },
        "id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*$",
          "type": "string"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/GraphPort"
          },
          "maxItems": 4096,
          "type": "array"
        },
        "kind": {
          "enum": [
            "main",
            "subgraph"
          ],
          "type": "string"
        },
        "name": {
          "maxLength": 256,
          "type": "string"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/Node"
          },
          "maxItems": 4096,
          "type": "array"
        },
        "outputs": {
          "items": {
            "$ref": "#/$defs/GraphPort"
          },
          "maxItems": 4096,
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "nodes",
        "edges",
        "inputs",
        "outputs"
      ],
      "type": "object"
    },
    "GraphCall": {
      "additionalProperties": false,
      "properties": {
        "bindings": {
          "additionalProperties": {
            "$ref": "#/$defs/InputBinding"
          },
          "type": "object"
        },
        "graphId": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*$",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*$",
          "type": "string"
        },
        "label": {
          "maxLength": 1024,
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/Position"
        }
      },
      "required": [
        "id",
        "graphId",
        "position",
        "bindings"
      ],
      "type": "object"
    },
    "GraphExit": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "enum": [
            "exec",
            "error"
          ],
          "type": "string"
        },
        "endpoint": {
          "$ref": "#/$defs/Endpoint"
        },
        "id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "channel",
        "endpoint"
      ],
      "type": "object"
    },
    "GraphPort": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*$",
          "type": "string"
        },
        "nodeId": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*$",
          "type": "string"
        },
        "portId": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*$",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/TypeExpression"
        }
      },
      "required": [
        "id",
        "type",
        "nodeId",
        "portId"
      ],
      "type": "object"
    },
    "InputBinding": {
      "additionalProperties": false,
      "properties": {
        "blob": {
          "$ref": "#/$defs/BlobRef"
        },
        "kind": {
          "enum": [
            "value",
            "default",
            "blob"
          ],
          "type": "string"
        },
        "value": true
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "Node": {
      "additionalProperties": false,
      "properties": {
        "bindings": {
          "additionalProperties": {
            "$ref": "#/$defs/InputBinding"
          },
          "type": "object"
        },
        "config": {
          "type": "object"
        },
        "disabled": {
          "type": "boolean"
        },
        "id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*$",
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "nodeRef": {
          "$ref": "#/$defs/NodeRef"
        },
        "position": {
          "$ref": "#/$defs/Position"
        }
      },
      "required": [
        "id",
        "nodeRef",
        "position",
        "config",
        "bindings"
      ],
      "type": "object"
    },
    "NodeRef": {
      "additionalProperties": false,
      "properties": {
        "nodeTypeId": {
          "format": "uri",
          "type": "string"
        },
        "semanticDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
          "type": "string"
        }
      },
      "required": [
        "nodeTypeId",
        "version",
        "semanticDigest"
      ],
      "type": "object"
    },
    "Position": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "type": "object"
    },
    "SecretRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*$",
          "type": "string"
        },
        "purpose": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "purpose"
      ],
      "type": "object"
    },
    "Size": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "type": "number"
        },
        "width": {
          "type": "number"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "type": "object"
    },
    "TypeExpression": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "ref",
              "type": "string"
            },
            "ref": {
              "$ref": "#/$defs/TypeRef"
            }
          },
          "required": [
            "kind",
            "ref"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "element": {
              "$ref": "#/$defs/TypeExpression"
            },
            "kind": {
              "const": "list",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "element"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "union",
              "type": "string"
            },
            "members": {
              "items": {
                "$ref": "#/$defs/TypeExpression"
              },
              "maxItems": 64,
              "minItems": 2,
              "type": "array"
            }
          },
          "required": [
            "kind",
            "members"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "constraints": {
              "items": {
                "maxLength": 1024,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 32,
              "type": "array"
            },
            "kind": {
              "const": "variable",
              "type": "string"
            },
            "variable": {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "kind",
            "variable"
          ],
          "type": "object"
        }
      ],
      "title": "TypeExpression"
    },
    "TypeRef": {
      "additionalProperties": false,
      "properties": {
        "semanticDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "typeId": {
          "format": "uri",
          "type": "string"
        }
      },
      "required": [
        "typeId",
        "semanticDigest"
      ],
      "type": "object"
    },
    "Variable": {
      "additionalProperties": false,
      "properties": {
        "default": true,
        "name": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*$",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/TypeExpression"
        }
      },
      "required": [
        "name",
        "type",
        "default"
      ],
      "type": "object"
    },
    "Workflow": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*$",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "type": "object"
    }
  },
  "$id": "https://yottaapp.dev/contracts/workflow/3.1/workflow-source.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "entryGraph": {
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*$",
      "type": "string"
    },
    "format": {
      "enum": [
        "yotta.workflow"
      ],
      "type": "string"
    },
    "graphs": {
      "items": {
        "$ref": "#/$defs/Graph"
      },
      "maxItems": 256,
      "minItems": 1,
      "type": "array"
    },
    "revision": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "secretRefs": {
      "items": {
        "$ref": "#/$defs/SecretRef"
      },
      "maxItems": 4096,
      "type": "array"
    },
    "variables": {
      "items": {
        "$ref": "#/$defs/Variable"
      },
      "maxItems": 4096,
      "type": "array"
    },
    "version": {
      "enum": [
        "3.1"
      ],
      "type": "string"
    },
    "workflow": {
      "$ref": "#/$defs/Workflow"
    }
  },
  "required": [
    "format",
    "version",
    "workflow",
    "revision",
    "entryGraph",
    "graphs",
    "variables",
    "secretRefs"
  ],
  "title": "Yotta Workflow Source",
  "type": "object"
}
