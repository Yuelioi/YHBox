            },
            "kind": {
              "const": "list",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "element"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "union",
