        "mediaType": {
          "maxLength": 255,
          "minLength": 3,
          "pattern": "^[a-z0-9][a-z0-9!#$\u0026^_.+-]+/[a-z0-9][a-z0-9!#$\u0026^_.+-]+$",
          "type": "string"
