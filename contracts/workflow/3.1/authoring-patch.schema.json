          },
          "required": [
            "kind",
            "members"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "constraints": {
              "items": {
                "maxLength": 1024,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 32,
              "type": "array"
            },
            "kind": {
              "const": "variable",
              "type": "string"
            },
            "variable": {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "kind",
            "variable"
          ],
          "type": "object"
        }
